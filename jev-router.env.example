# Copy the values you need to ~/.jev-router.env and set mode 0600.
JEV_API_KEY=replace-me

# active: execute Jev's choice; shadow: record Jev's choice but execute the baseline.
JEV_DESKTOP_MODE=active
JEV_DESKTOP_BASELINE=gpt-5.6-terra

# Optional routing settings.
JEV_DESKTOP_DEADLINE_MS=8000
JEV_CODEX_FAST_MODEL=gpt-5.5
# JEV_ALLOW_FABLE=1
